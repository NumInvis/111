{
  "name": "variational-infinity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev:api": "pnpm --filter @variational-infinity/api dev",
    "dev:web": "pnpm --filter @mythweaver/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:push": "pnpm --filter @variational-infinity/api prisma:push",
    "db:migrate": "pnpm --filter @variational-infinity/api prisma:migrate",
    "db:generate": "pnpm --filter @variational-infinity/api prisma:generate"
  },
  "onlyBuiltDependencies": [
    "esbuild",
    "unrs-resolver",
    "@swc/core"
  ]
}

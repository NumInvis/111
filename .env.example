# Environment template. Copy to `.env.local` for local development.
# Never commit real keys.

# Frontend only calls the backend API. Do not put real model keys in frontend env.
VITE_API_BASE_URL=http://localhost:3000/api
VITE_LOG_LEVEL=info

# Server-side LLM variables (NestJS API).
AI_BASE_URL=https://wincode.winning.com.cn/ai/v1
AI_MODEL=deepseek-v4-flash
AI_API_KEY=sk-your-real-key-here
AI_TIMEOUT_MS=300000

LOG_LEVEL=info
LOG_FORMAT=pretty
LOG_REQUEST_BODY_MAX_LEN=2000

# Runtime services.
DATABASE_URL=postgresql://vi:vi_local_dev@localhost:5432/variational_infinity

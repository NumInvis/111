# AI provider configuration. Copy to `.env.local` for local development.
# Never commit real keys.

# Frontend only calls the backend API. Do not put real model keys in frontend env.
VITE_API_BASE_URL=http://localhost:3000
VITE_AI_PROVIDER_LABEL=openai-compatible

# Server-side LLM Gateway variables (NestJS API).
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://api.example.com/v1
AI_MODEL=gpt-4
AI_API_KEY=sk-your-real-key-here

# Agent Service (Python FastAPI).
AGENT_SERVICE_URL=http://localhost:8000
AGENT_LLM_PROVIDER=openai-compatible
AGENT_LLM_BASE_URL=https://api.example.com/v1
AGENT_LLM_MODEL=gpt-4
AGENT_LLM_API_KEY=sk-your-real-key-here

# Runtime services.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/variational_infinity
REDIS_URL=redis://localhost:6379
SESSION_SECRET=change-me
